# ─────────────────────────────────────────────────────────────
# Polymarket Trader 环境变量配置
# 复制为 .env 并按需修改，或直接在系统环境变量中设置
# 优先级: 环境变量 > config.yaml > 默认值
# ─────────────────────────────────────────────────────────────

# ── 代理设置（可选） ──────────────────────────────────────────
# 如果你的网络无法直接访问 Polymarket API，请设置代理
# 支持 HTTP 和 SOCKS5 代理
PROXY_HTTP=
PROXY_HTTPS=
# 示例:
# PROXY_HTTP=http://127.0.0.1:7890
# PROXY_HTTPS=http://127.0.0.1:7890

# ── Polymarket API 凭据（可选，真实跟单需要） ────────────────
# 以下凭据仅在执行模式为 live 时使用
# 获取方式: https://polymarket.com → 设置 → API Keys
# ⚠️ 安全警告: 切勿将凭据提交到版本控制或分享给他人
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# 你的 Polygon 钱包地址 (0x...)
POLYMARKET_WALLET_ADDRESS=
# 你的私钥（仅本地使用，切勿泄露）
POLYMARKET_PRIVATE_KEY=

# ── 监控配置 ──────────────────────────────────────────────────
# 轮询间隔（秒）— 秒级实时建议 1-5 秒
# 间隔越短越实时，但会增加 API 请求频率
MONITOR_INTERVAL=2

# 最小轮询间隔（秒），硬下限，防止过于频繁
MONITOR_MIN_INTERVAL=1

# 是否启用 WebSocket Market Channel（实时价格缓存，需联网）
MONITOR_WS_ENABLED=true

# ── 订单金额监测范围（USDC）──────────────────────────────────
# 只监测「成交金额 = 价格 × 数量」落在此闭区间内的交易，区间外直接忽略。
# 两者填 0 表示不限制；也可在「设置 → 监控配置」里随时调整。
MONITOR_MIN_AMOUNT=0
MONITOR_MAX_AMOUNT=0

# ── 风险控制参数 ──────────────────────────────────────────────
# 单笔交易最大金额 (USDC)
RISK_MAX_TRADE_AMOUNT=100.0
# 单个市场最大仓位 (USDC)
RISK_MAX_POSITION_PER_MARKET=500.0
# 每日最大交易次数
RISK_MAX_DAILY_TRADES=50

# ── 执行器配置 ────────────────────────────────────────────────
# 执行模式:
#   paper = 模拟执行（不实际下单，仅记录和计算模拟盈亏）
#   live  = 实盘执行（使用 API 凭据实际下单，⚠️ 有真实资金风险）
EXECUTOR_MODE=paper

# ── 服务器配置 ────────────────────────────────────────────────
# 监听端口
SERVER_PORT=8765
# 监听地址 (0.0.0.0 = 所有网卡, 127.0.0.1 = 仅本机)
SERVER_HOST=0.0.0.0

# ── 通知推送配置（可选） ─────────────────────────────────────
# 让用户不用一直盯屏幕：交易/信号/成交/失败/风控/汇总 主动推送

# 是否启用 Telegram 通知 (true/false)
TELEGRAM_ENABLED=false
# Telegram Bot Token（从 @BotFather 获取）
# ⚠️ 安全警告: 切勿将 Token 提交到版本控制或分享给他人
TELEGRAM_TOKEN=
# 接收方 Chat ID（多个用英文逗号分隔）
#   个人号: 123456789      群组: -1001234567890
TELEGRAM_CHAT_IDS=

# 是否启用邮件通知 (true/false)
EMAIL_ENABLED=false
# SMTP 服务器地址（QQ邮箱: smtp.qq.com / Gmail: smtp.gmail.com / 163: smtp.163.com）
EMAIL_HOST=
# SMTP 端口：465 = SSL，587 = STARTTLS
EMAIL_PORT=587
# SMTP 用户名（通常为邮箱地址）
EMAIL_USER=
# SMTP 密码 / 授权码（QQ邮箱需使用「授权码」而非登录密码）
# ⚠️ 安全警告: 切勿将密码提交到版本控制
EMAIL_PASSWORD=
# 发件人地址（留空则使用 EMAIL_USER）
EMAIL_FROM=
# 收件人地址（多个用英文逗号分隔）
EMAIL_TO=
# 是否使用隐式 SSL（true = 端口 465；false = STARTTLS 端口 587）
EMAIL_USE_SSL=false

# 最小通知金额 (USDC)：低于此金额的交易不推送，0 = 不过滤
NOTIFY_MIN_AMOUNT=0
# 需要推送的事件类型（逗号分隔，空 = 全部推送）
# 可选值: trade_detected, signal_generated, execution_filled,
#         execution_failed, risk_blocked, daily_summary
NOTIFY_EVENTS=
# 仅推送指定源钱包（逗号分隔，空 = 不限制）
NOTIFY_WALLETS=
# 同一事件的重复推送冷却时间（秒），0 = 不限制
NOTIFY_COOLDOWN=0
# 每日汇总发送时间（UTC 小时 / 分钟）
NOTIFY_SUMMARY_HOUR=8
NOTIFY_SUMMARY_MINUTE=0

# ── 配置文件路径（可选） ──────────────────────────────────────
# 指定 YAML 配置文件路径，默认为项目根目录下的 config.yaml
CONFIG_FILE=config.yaml

# ── 数据库路径（可选） ────────────────────────────────────────
# SQLite 数据库文件路径，默认为 data/trader.db
# DB_PATH=data/trader.db

# 实盘签名类型：0 EOA / 1 POLY_PROXY / 2 GNOSIS_SAFE
POLYMARKET_SIGNATURE_TYPE=0
# 代理签名的钱包资金地址（不是签名私钥对应地址）
POLYMARKET_FUNDER=
