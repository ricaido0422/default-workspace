# Docker Compose 环境变量示例文件
# 使用方法：复制为 .env.docker，按需填写后重启容器
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
# 注意：本文件只放空占位与默认值，禁止填写真实密钥

# ===== 代理设置（宿主机能访问 Polymarket API 时保持留空）=====
# HTTP_PROXY=                      # HTTP 代理，例: http://127.0.0.1:7890
# HTTPS_PROXY=                     # HTTPS 代理，例: http://127.0.0.1:7890
# NO_PROXY=                        # 不走代理的地址，默认: localhost,127.0.0.1

# ===== 执行模式 =====
# EXECUTOR__MODE=paper             # paper=模拟交易（默认）/ live=实盘交易（需另行配置 API 凭据）

# ===== 监控轮询 =====
# MONITOR_INTERVAL=2               # 轮询间隔（秒），默认 2
# MONITOR_MIN_INTERVAL=1           # 允许的最小轮询间隔（秒），默认 1
# MONITOR_WS_ENABLED=true          # 是否启用 WebSocket 价格推送，默认 true
# MONITOR_MIN_AMOUNT=0             # 订单金额监测下限（USDC），0 = 不限制
# MONITOR_MAX_AMOUNT=0             # 订单金额监测上限（USDC），0 = 不限制

# ===== 风控 =====
# RISK__MAX_TRADE_AMOUNT=100.0     # 单笔最大金额（USDC），默认 100.0
# RISK__MAX_POSITION_PER_MARKET=500.0  # 单市场最大仓位（USDC），默认 500.0
# RISK__MAX_DAILY_TRADES=50        # 每日最大交易数，默认 50

# ===== 通知开关 =====
# 说明：Telegram 通知是否启用，留空表示沿用 config.yaml 中的配置
# TELEGRAM_ENABLED=                # true=启用 / false=关闭，示例文件中不提供默认值
# 注意：Bot Token（TELEGRAM_TOKEN）与 chat_id（TELEGRAM_CHAT_IDS）属敏感信息，
#       请通过 config.yaml 或 Web 设置页配置，不要写入本文件
